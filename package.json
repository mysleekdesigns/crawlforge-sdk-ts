{
  "name": "crawlforge-sdk",
  "version": "0.1.1",
  "description": "Official TypeScript SDK for the CrawlForge REST API: 30 metered web tools behind one API key.",
  "license": "MIT",
  "author": "CrawlForge <simon@crawlforge.dev>",
  "homepage": "https://www.crawlforge.dev/docs/api-reference",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mysleekdesigns/crawlforge-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/mysleekdesigns/crawlforge-sdk-ts/issues"
  },
  "keywords": [
    "crawlforge",
    "web-scraping",
    "scraper",
    "crawler",
    "sdk",
    "api-client",
    "search",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/gen-schema.mjs && node scripts/gen-tools.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "openapi-typescript": "7.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
